# A model too large for one node: sglang pipeline-parallel over 4 inference nodes.
# extends: sglang.env
INFERENCE_NODES=4
INFERENCE_MODE=pp
VLLM_DISTRIBUTED_TIMEOUT_SECONDS=7200
# GPU-direct RDMA off: on this fabric it silently corrupts cross-node sums, and a connect can fail registering GPU
# memory (NET/OFI regattr RC -22). LOC, not 0: RCCL reads a number as an old-style path level. run_cluster.sh puts it
# on the server command, because the CSCS netstack hook overwrites the step's value with PHB.
NCCL_NET_GDR_LEVEL=LOC
VLLM_EXTRA_ARGS=
THROUGHPUT_PROBE_REQUESTS=3
AGENT_START_STAGGER_SECONDS=60
AGENT_START_STAGGER_MAX_SECONDS=300
SGLANG_ROCM_FUSED_DECODE_MLA=0
AITER_LOG_TUNED_CONFIG=1
