# A non-LLM tuner standing where a model stands (the setup's model is the tuner's `hpcagent-bench agent` name, env
# TUNER): no inference node; the agent node runs the judge image and the driver deals one tuner per problem, each
# measuring only through its judge.
# extends: common.env
INFERENCE_SOURCE=none
INFERENCE_NODES=0
HARNESS=tuner
AGENTS_PER_NODE=40
JUDGE_INPUT_MODE=any
